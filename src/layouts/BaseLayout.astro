---
import '../styles.css';
import '../site-pages.css';
import '../suno-pages.css';

interface Props {
  title: string;
  description?: string;
  robots?: string;
  pageType?: 'website' | 'article';
  canonicalPath?: string;
  socialTitle?: string;
  socialDescription?: string;
  socialImagePath?: string;
  socialImageAlt?: string;
}

const {
  title,
  description = 'Процедурный генератор MIDI-мелодий для AI-музыкальных workflow. Без сэмплов, без аудиопетель, без copyrighted training data.',
  robots = 'index,follow',
  pageType = 'website',
  canonicalPath,
  socialTitle,
  socialDescription,
  socialImagePath = '/og.png',
  socialImageAlt = 'Melody Seed Generator: мелодия, аккорды и бас на piano roll'
} = Astro.props;

const pageTitle =
  title === 'Melody Seed Generator' ? title : `${title} — Melody Seed Generator`;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? Astro.url);
const socialCardTitle = socialTitle ?? pageTitle;
const socialCardDescription = socialDescription ?? description;
const socialImageUrl = new URL(socialImagePath, Astro.site ?? Astro.url);
const currentYear = new Date().getFullYear();
const isGeneratorPage = currentPath === '/' || currentPath === '/generator';

function navClass(href: string) {
  const normalized = href === '/' ? '/' : href.replace(/\/$/, '');
  return currentPath === normalized ? 'is-active' : '';
}
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#080a0f" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Melody Seed Generator" />
    <meta property="og:title" content={socialCardTitle} />
    <meta property="og:description" content={socialCardDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialCardTitle} />
    <meta name="twitter:description" content={socialCardDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Перейти к содержанию</a>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-header__left">
          <a href="/" class="site-header__logo" aria-label="Открыть Melody Seed Generator">
            <svg class="site-header__mark" viewBox="0 0 40 40" aria-hidden="true">
              <defs>
                <linearGradient id="brand-mark-gradient" x1="8" y1="14" x2="32" y2="28" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#ff8052" />
                  <stop offset="1" stop-color="#4fe2cf" />
                </linearGradient>
              </defs>
              <rect class="site-header__mark-frame" x="1.5" y="1.5" width="37" height="37" rx="10.5" />
              <path class="site-header__mark-signal" d="M9.5 25.5V12L20 21.5L30.5 12V25.5" />
              <circle class="site-header__mark-node site-header__mark-node--warm" cx="9.5" cy="25.5" r="2.5" />
              <circle class="site-header__mark-node site-header__mark-node--mint" cx="30.5" cy="25.5" r="2.5" />
            </svg>
          </a>
          <nav class="site-header__nav" aria-label="Основная навигация">
            <a href="/" class={isGeneratorPage ? 'is-active' : ''}>Генератор</a>
            <a href="/instructions" class={navClass('/instructions')}>Инструкция</a>
            <a href="/suno-tips" class={navClass('/suno-tips')}>Советы для SUNO</a>
            <a href="/development" class={navClass('/development')}>Развитие проекта</a>
          </nav>
        </div>
        <button
          class="site-header__services"
          type="button"
          aria-haspopup="dialog"
          aria-controls="contact-drawer"
          aria-expanded="false"
          data-contact-open
        >
          Разработка web-приложений
        </button>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <span>© {currentYear} Melody Seed Generator</span>
      <a href="/privacy">Конфиденциальность</a>
    </footer>

    <div class="contact-drawer" id="contact-drawer" hidden data-contact-drawer>
      <div class="contact-drawer__backdrop" data-contact-close></div>
      <aside
        class="contact-drawer__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="contact-drawer-title"
      >
        <button class="contact-drawer__close" type="button" aria-label="Закрыть" data-contact-close>
          <span aria-hidden="true">×</span>
        </button>

        <div class="contact-drawer__content">
          <p class="contact-drawer__eyebrow"><span aria-hidden="true"></span> Разработка на заказ</p>
          <h2 id="contact-drawer-title">Делаю web-приложения под ключ</h2>
          <p class="contact-drawer__lead">
            Продумываю структуру, интерфейс и пользовательские сценарии, собираю и запускаю
            рабочий продукт. Этот сайт — один из примеров моей работы.
          </p>

          <div class="contact-drawer__contacts" aria-label="Контакты Михаила">
            <a href="https://t.me/trip_to_lila" target="_blank" rel="noopener noreferrer">
              <span>Телеграм</span>
              <i aria-hidden="true">↗</i>
            </a>
            <a href="https://vk.ru/mr.madhu" target="_blank" rel="noopener noreferrer">
              <span>ВКонтакте</span>
              <i aria-hidden="true">↗</i>
            </a>
          </div>
        </div>

        <p class="contact-drawer__note">Можно прийти с идеей, прототипом или уже работающим проектом.</p>
      </aside>
    </div>
  </body>
</html>

<style>
  .site-header__nav a.is-active {
    color: #fff;
    border-color: rgba(255, 116, 72, 0.48);
  }
</style>

<script>
  const siteNavigation = document.querySelector<HTMLElement>('.site-header__nav');
  const activeNavigationItem = siteNavigation?.querySelector<HTMLElement>('a.is-active');

  window.requestAnimationFrame(() => {
    if (!siteNavigation || !activeNavigationItem) return;

    const navigationRect = siteNavigation.getBoundingClientRect();
    const activeItemRect = activeNavigationItem.getBoundingClientRect();
    if (activeItemRect.right > navigationRect.right) {
      siteNavigation.scrollLeft += activeItemRect.right - navigationRect.right + 8;
    } else if (activeItemRect.left < navigationRect.left) {
      siteNavigation.scrollLeft -= navigationRect.left - activeItemRect.left + 8;
    }
  });

  const contactDrawer = document.querySelector<HTMLElement>('[data-contact-drawer]');
  const contactOpen = document.querySelector<HTMLButtonElement>('[data-contact-open]');
  const contactCloseControls = contactDrawer?.querySelectorAll<HTMLElement>('[data-contact-close]');
  const contactPanel = contactDrawer?.querySelector<HTMLElement>('.contact-drawer__panel');
  let contactReturnFocus: HTMLElement | null = null;
  let contactInertElements: HTMLElement[] = [];
  let contactCloseTimer: number | undefined;

  function setContactBackgroundInert(inert: boolean) {
    if (inert) {
      contactInertElements = Array.from(
        document.querySelectorAll<HTMLElement>('.skip-link, .site-header, main, astro-island, .site-footer')
      );
    }

    contactInertElements.forEach((element) => {
      element.inert = inert;
      if (inert) element.setAttribute('aria-hidden', 'true');
      else element.removeAttribute('aria-hidden');
    });

    if (!inert) contactInertElements = [];
  }

  function openContactDrawer() {
    if (!contactDrawer || !contactOpen || !contactPanel) return;

    window.clearTimeout(contactCloseTimer);
    contactReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : contactOpen;
    contactDrawer.hidden = false;
    setContactBackgroundInert(true);
    document.body.classList.add('has-contact-drawer');
    contactOpen.setAttribute('aria-expanded', 'true');
    window.requestAnimationFrame(() => {
      contactDrawer.classList.add('is-open');
      contactDrawer.querySelector<HTMLButtonElement>('.contact-drawer__close')?.focus();
    });
  }

  function closeContactDrawer() {
    if (!contactDrawer || !contactOpen || contactDrawer.hidden) return;

    contactDrawer.classList.remove('is-open');
    document.body.classList.remove('has-contact-drawer');
    contactOpen.setAttribute('aria-expanded', 'false');
    contactCloseTimer = window.setTimeout(() => {
      contactDrawer.hidden = true;
      setContactBackgroundInert(false);
      contactReturnFocus?.focus();
    }, 220);
  }

  contactOpen?.addEventListener('click', openContactDrawer);
  contactCloseControls?.forEach((control) => control.addEventListener('click', closeContactDrawer));

  document.addEventListener('keydown', (event) => {
    if (!contactDrawer || contactDrawer.hidden || !contactPanel) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeContactDrawer();
      return;
    }

    if (event.key !== 'Tab') return;
    const focusable = Array.from(
      contactPanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    );
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
