---
import '../styles.css';
import '../site-pages.css';
import '../suno-pages.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Процедурный генератор MIDI-мелодий для AI-музыкальных workflow. Без сэмплов, без аудиопетель, без copyrighted training data.'
} = Astro.props;

const pageTitle =
  title === 'Melody Seed Generator' ? title : `${title} — Melody Seed Generator`;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function navClass(href: string) {
  const normalized = href === '/' ? '/' : href.replace(/\/$/, '');
  return currentPath === normalized ? 'is-active' : '';
}
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-header__left">
          <a href="/generator" class="site-header__logo" aria-label="Открыть Melody Seed Generator">
            <svg class="site-header__mark" viewBox="0 0 40 40" aria-hidden="true">
              <defs>
                <linearGradient id="brand-mark-gradient" x1="8" y1="14" x2="32" y2="28" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#ff8052" />
                  <stop offset="1" stop-color="#4fe2cf" />
                </linearGradient>
              </defs>
              <rect class="site-header__mark-frame" x="1.5" y="1.5" width="37" height="37" rx="10.5" />
              <path class="site-header__mark-signal" d="M9.5 25.5V12L20 21.5L30.5 12V25.5" />
              <circle class="site-header__mark-node site-header__mark-node--warm" cx="9.5" cy="25.5" r="2.5" />
              <circle class="site-header__mark-node site-header__mark-node--mint" cx="30.5" cy="25.5" r="2.5" />
            </svg>
          </a>
          <nav class="site-header__nav" aria-label="Main">
            <a href="/generator" class={navClass('/generator')}>Генератор</a>
            <a href="/instructions" class={navClass('/instructions')}>Инструкция</a>
            <a href="/suno-tips" class={navClass('/suno-tips')}>Советы для SUNO</a>
          </nav>
        </div>
        <a href="/development" class={`site-header__support ${navClass('/development')}`}>
          <span class="site-header__support-dot" aria-hidden="true"></span>
          Развитие проекта
        </a>
      </div>
    </header>

    <slot />
  </body>
</html>

<style>
  .site-header__nav a.is-active,
  .site-header__support.is-active {
    color: #fff;
    border-color: rgba(255, 116, 72, 0.48);
  }
</style>
