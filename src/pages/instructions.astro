---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  COMPLEXITY_OPTIONS,
  DRAMA_OPTIONS,
  GENRE_OPTIONS,
  HOOKINESS_OPTIONS,
  ROLE_OPTIONS
} from '../lib/melody/intent';
import { SCALE_OPTIONS } from '../lib/music/scales';
import {
  BASS_MODE_OPTIONS,
  CHORD_FEEL_OPTIONS,
  CHORD_LENGTH_OPTIONS,
  CHORD_PATTERN_OPTIONS,
  DOWNLOAD_OPTIONS
} from '../lib/ui/controlOptions';

const intentGroups = [
  {
    title: 'Melodic Language',
    description: 'Общий музыкальный характер.',
    options: GENRE_OPTIONS,
    details: {
      'pop-hook': 'понятные диатонические ходы для поп-идей',
      'dark-trap': 'тёмное минорное настроение',
      'edm-lead': 'яркая и энергичная электронная подача',
      'afro-house': 'модальное и ритмичное движение',
      cinematic: 'атмосферный кинематографичный минор',
      hyperpop: 'резкий, яркий и современный характер'
    }
  },
  {
    title: 'Song Part',
    description: 'Роль идеи в будущем треке.',
    options: ROLE_OPTIONS,
    details: {
      'chorus-hook': 'цепкая фраза для припева или главного хука',
      'verse-motif': 'более спокойный мотив для куплета',
      'drop-lead': 'энергичная и повторяемая идея для дропа',
      'pre-chorus-lift': 'переходная фраза с движением к припеву'
    }
  },
  {
    title: 'Phrase Shape',
    description: 'Драматургия музыкальной фразы.',
    options: DRAMA_OPTIONS,
    details: {
      'question-answer': 'две части ощущаются как вопрос и ответ',
      'build-release': 'нарастание заканчивается разрешением',
      'call-response': 'музыкальный призыв получает отклик',
      'loopable-hook': 'фраза рассчитана на повтор по кругу'
    }
  },
  {
    title: 'Detail',
    description: 'Насыщенность мелодии.',
    options: COMPLEXITY_OPTIONS,
    details: {
      simple: 'меньше нот и проще запомнить',
      balanced: 'средняя детализация',
      twisty: 'больше движения и неожиданных поворотов'
    }
  },
  {
    title: 'Hook Strength',
    description: 'Насколько явно мелодия стремится быть цепкой.',
    options: HOOKINESS_OPTIONS,
    details: {
      safe: 'мягкая и спокойная идея',
      catchy: 'заметный, но сбалансированный хук',
      bold: 'акцентная и более запоминающаяся фраза'
    }
  }
] as const;

const manualSettings = [
  ['Key / Tonic', 'Основная нота тональности. Она сохраняется при смене Hook Intent.'],
  ['Scale Mode', `Лад мелодии: ${SCALE_OPTIONS.join(', ')}.`],
  ['Bars', 'Длина идеи от 2 до 16 тактов.'],
  ['Tempo', 'Скорость воспроизведения от 60 до 190 BPM.'],
  ['Octave', 'Основной регистр мелодии: от 2 до 6 октавы.'],
  ['Pitch Range', 'Допустимый размах мелодии от 7 до 36 полутонов.']
] as const;

const advancedSettings = [
  ['Note density', 'сколько нот появляется в доступном времени'],
  ['Rest chance', 'как часто генератор оставляет паузы'],
  ['Variation amount', 'насколько части фразы отличаются друг от друга'],
  ['Randomness', 'сколько непредсказуемости допускается при генерации']
] as const;

const chordOptionGroups = [
  {
    title: 'Pattern',
    options: CHORD_PATTERN_OPTIONS,
    details: {
      sustained: 'один длинный аккордовый импульс',
      'half-bar': 'два импульса на такт',
      'quarter-pulse': 'движение по четвертям',
      syncopated: 'более живой синкопированный рисунок'
    }
  },
  {
    title: 'Length',
    options: CHORD_LENGTH_OPTIONS,
    details: {
      long: 'длинные ноты',
      medium: 'средняя длительность',
      short: 'короткие ноты',
      staccato: 'максимально отрывистая подача'
    }
  },
  {
    title: 'Feel',
    options: CHORD_FEEL_OPTIONS,
    details: {
      straight: 'ровное исполнение',
      subtle: 'лёгкая живость',
      groovy: 'больше ритмического движения',
      loose: 'более свободное ощущение'
    }
  }
] as const;

const bassDetails = {
  'root-pulse': 'простой пульс по основным нотам аккордов',
  groove: 'более ритмичный басовый рисунок',
  sparse: 'редкий минималистичный бас'
} as const;

const availableDownloads = DOWNLOAD_OPTIONS.filter((option) => !option.disabled);
---

<BaseLayout
  title="Инструкция"
  description="Практическая инструкция по Melody Seed Generator: первый seed, настройки, слои, сохранение проекта и экспорт WAV/MIDI."
>
  <main class="page-content instructions-page">
    <section class="instr-hero panel">
      <div class="instr-hero__copy">
        <p class="eyebrow instr-eyebrow"><span aria-hidden="true"></span> Quick manual</p>
        <h1>От идеи до файла<br />за несколько минут</h1>
        <p class="lead">
          Выберите характер мелодии, создайте seed, настройте слои и сохраните удачный вариант.
        </p>
        <div class="instr-hero__actions">
          <a href="/generator" class="instr-button instr-button--primary">Открыть генератор <span>↗</span></a>
          <a href="#quick-start" class="instr-button instr-button--quiet">Как это работает</a>
        </div>
      </div>
      <div class="instr-hero__signal" aria-hidden="true">
        <span class="instr-signal__label">SEED FLOW</span>
        <div class="instr-signal__lane instr-signal__lane--melody"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="instr-signal__lane instr-signal__lane--chord"><i></i><i></i><i></i></div>
        <div class="instr-signal__lane instr-signal__lane--bass"><i></i><i></i><i></i><i></i></div>
      </div>
      <nav class="instr-nav" aria-label="Содержание инструкции">
        <a href="#quick-start">Быстрый старт</a>
        <a href="#settings">Настройки</a>
        <a href="#layers">Слои</a>
        <a href="#projects">Project</a>
        <a href="#export">Экспорт</a>
      </nav>
    </section>

    <section class="instr-panel panel" id="quick-start">
      <header class="instr-panel__header">
        <div>
          <p class="eyebrow instr-eyebrow">Quick start</p>
          <h2>Первый seed — четыре действия</h2>
        </div>
        <p>Seed — короткая музыкальная заготовка, не готовая песня.</p>
      </header>
      <ol class="instr-flow">
        <li><span>01</span><strong>Задайте характер</strong><p>Сначала выберите параметры Hook Intent.</p></li>
        <li><span>02</span><strong>Создайте идею</strong><p>Нажмите Generate Seed, затем Play.</p></li>
        <li><span>03</span><strong>Сравните слои</strong><p>Включайте и отключайте аккорды и бас.</p></li>
        <li><span>04</span><strong>Сохраните</strong><p>Скачайте Project, WAV или MIDI.</p></li>
      </ol>
      <div class="instr-alert instr-alert--warm">
        <span aria-hidden="true">!</span>
        <p><strong>Не потеряйте вариант.</strong> Generate New Seed заменяет текущий результат, а истории версий нет.</p>
      </div>
    </section>

    <div class="instr-dashboard">
      <div class="instr-dashboard__main">
        <section class="instr-panel panel" id="settings">
          <header class="instr-panel__header">
            <div>
              <p class="eyebrow instr-eyebrow">Control deck</p>
              <h2>Сначала характер, потом детали</h2>
            </div>
          </header>
          <p class="instr-panel__intro">
            Hook Intent быстро собирает рабочий пресет. Ручные настройки нужны, только когда хочется
            точнее контролировать результат.
          </p>
          <div class="instr-alert">
            <span aria-hidden="true">i</span>
            <p>Изменение Hook Intent сбрасывает Scale Mode, Bars, Tempo, Octave, Pitch Range и Advanced tuning. Key / Tonic сохраняется.</p>
          </div>

          <div class="instr-disclosures">
            <details class="instr-disclosure">
              <summary>
                <span><strong>Hook Intent</strong><small>Пять параметров характера мелодии</small></span>
                <i aria-hidden="true"></i>
              </summary>
              <div class="instr-disclosure__body instr-reference-grid">
                {intentGroups.map((group) => (
                  <article class="instr-reference-block">
                    <h3>{group.title}</h3>
                    <p>{group.description}</p>
                    <ul>
                      {group.options.map((option) => (
                        <li><strong>{option.label}</strong><span>{group.details[option.value]}</span></li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </details>

            <details class="instr-disclosure">
              <summary>
                <span><strong>Melody Settings</strong><small>Тональность, длина, темп и диапазон</small></span>
                <i aria-hidden="true"></i>
              </summary>
              <dl class="instr-disclosure__body instr-setting-list">
                {manualSettings.map(([name, description]) => (
                  <div><dt>{name}</dt><dd>{description}</dd></div>
                ))}
              </dl>
            </details>

            <details class="instr-disclosure">
              <summary>
                <span><strong>Advanced tuning</strong><small>Плотность, паузы, вариативность и случайность</small></span>
                <i aria-hidden="true"></i>
              </summary>
              <dl class="instr-disclosure__body instr-setting-list">
                {advancedSettings.map(([name, description]) => (
                  <div><dt>{name}</dt><dd>{description}.</dd></div>
                ))}
              </dl>
            </details>
          </div>
        </section>

        <section class="instr-panel panel" id="layers">
          <header class="instr-panel__header">
            <div>
              <p class="eyebrow instr-eyebrow">Three-layer output</p>
              <h2>Одна идея, три музыкальных слоя</h2>
            </div>
          </header>

          <div class="instr-layer-list">
            <article class="instr-layer instr-layer--melody">
              <span class="instr-layer__key">M</span>
              <div><h3>Melody</h3><p>Главная музыкальная фраза. Меняется только при генерации нового seed.</p></div>
            </article>
            <article class="instr-layer instr-layer--chord">
              <span class="instr-layer__key">C</span>
              <div><h3>Chord Layer</h3><p>Гармония. Слой можно отключить, настроить или регенерировать.</p></div>
            </article>
            <article class="instr-layer instr-layer--bass">
              <span class="instr-layer__key">B</span>
              <div><h3>Bass Layer</h3><p>Нижний голос, автоматически построенный по текущим аккордам.</p></div>
            </article>
          </div>

          <div class="instr-alert instr-alert--mint">
            <span aria-hidden="true">↻</span>
            <p>Изменение или регенерация Chord Layer перестраивает Bass Layer под новые аккорды. Режим баса сохраняется.</p>
          </div>

          <details class="instr-disclosure instr-disclosure--standalone">
            <summary>
              <span><strong>Все режимы слоёв</strong><small>Pattern, Length, Feel и Bass Mode</small></span>
              <i aria-hidden="true"></i>
            </summary>
            <div class="instr-disclosure__body instr-reference-grid">
              {chordOptionGroups.map((group) => (
                <article class="instr-reference-block">
                  <h3>{group.title}</h3>
                  <ul>
                    {group.options.map((option) => (
                      <li><strong>{option.label}</strong><span>{group.details[option.value]}</span></li>
                    ))}
                  </ul>
                </article>
              ))}
              <article class="instr-reference-block">
                <h3>Bass Mode</h3>
                <ul>
                  {BASS_MODE_OPTIONS.map((option) => (
                    <li><strong>{option.label}</strong><span>{bassDetails[option.value]}</span></li>
                  ))}
                </ul>
              </article>
            </div>
          </details>
        </section>
      </div>

      <aside class="instr-dashboard__side">
        <section class="instr-panel panel" id="projects">
          <header class="instr-panel__header">
            <div>
              <p class="eyebrow instr-eyebrow">Save state</p>
              <h2>Project — ваша точка возврата</h2>
            </div>
          </header>
          <p class="instr-panel__intro">
            Файл <code>.melody-seed.json</code> хранит мелодию, настройки, аккорды, бас и состояние слоёв.
          </p>
          <div class="instr-action-list">
            <div><span>↓</span><p><strong>Сохранить</strong>Выберите Project в блоке Download.</p></div>
            <div><span>↑</span><p><strong>Открыть</strong>Перетащите файл в Open Project или нажмите значок загрузки.</p></div>
          </div>
          <p class="instr-mini-warning">Открытие Project тоже заменяет текущий seed.</p>
        </section>

        <section class="instr-panel panel" id="export">
          <header class="instr-panel__header">
            <div>
              <p class="eyebrow instr-eyebrow">Download</p>
              <h2>Выберите нужный формат</h2>
            </div>
          </header>
          <div class="instr-format-list">
            {availableDownloads.map((option) => (
              <article class:list={['instr-format', `instr-format--${option.value}`]}>
                <strong>{option.label}</strong>
                {option.value === 'wav' && <p>Готовое аудио для прослушивания или AI-сервиса.</p>}
                {option.value === 'midi' && <p>Редактируемые ноты для дальнейшей работы в DAW.</p>}
                {option.value === 'project' && <p>Полное состояние для продолжения в генераторе.</p>}
              </article>
            ))}
          </div>
          <p class="instr-panel__note">В WAV и MIDI попадают только активные слои. MP3 пока недоступен.</p>
        </section>

        <section class="instr-panel panel instr-limits" id="limits">
          <header class="instr-panel__header">
            <div>
              <p class="eyebrow instr-eyebrow">Good to know</p>
              <h2>Границы инструмента</h2>
            </div>
          </header>
          <ul>
            <li>Это seed, а не готовая песня.</li>
            <li>Редактирования отдельных нот нет.</li>
            <li>История вариантов не сохраняется.</li>
            <li>Генератор не заменяет DAW.</li>
            <li>Внешний AI-сервис может переосмыслить исходную идею.</li>
          </ul>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>
