---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  COMPLEXITY_OPTIONS,
  DRAMA_OPTIONS,
  GENRE_OPTIONS,
  HOOKINESS_OPTIONS,
  ROLE_OPTIONS
} from '../lib/melody/intent';
import { SCALE_OPTIONS } from '../lib/music/scales';
import {
  BASS_MODE_OPTIONS,
  CHORD_FEEL_OPTIONS,
  CHORD_LENGTH_OPTIONS,
  CHORD_PATTERN_OPTIONS,
  DOWNLOAD_OPTIONS
} from '../lib/ui/controlOptions';

const intentGroups = [
  {
    title: 'Melodic Language',
    description: 'Общий музыкальный характер.',
    options: GENRE_OPTIONS,
    details: {
      'pop-hook': 'понятные диатонические ходы для поп-идей',
      'dark-trap': 'тёмное минорное настроение',
      'edm-lead': 'яркая и энергичная электронная подача',
      'afro-house': 'модальное и ритмичное движение',
      cinematic: 'атмосферный кинематографичный минор',
      hyperpop: 'резкий, яркий и современный характер'
    }
  },
  {
    title: 'Song Part',
    description: 'Роль идеи в будущем треке.',
    options: ROLE_OPTIONS,
    details: {
      'chorus-hook': 'цепкая фраза для припева или главного хука',
      'verse-motif': 'более спокойный мотив для куплета',
      'drop-lead': 'энергичная и повторяемая идея для дропа',
      'pre-chorus-lift': 'переходная фраза с движением к припеву'
    }
  },
  {
    title: 'Phrase Shape',
    description: 'Драматургия музыкальной фразы.',
    options: DRAMA_OPTIONS,
    details: {
      'question-answer': 'две части ощущаются как вопрос и ответ',
      'build-release': 'нарастание заканчивается разрешением',
      'call-response': 'музыкальный призыв получает отклик',
      'loopable-hook': 'фраза рассчитана на повтор по кругу'
    }
  },
  {
    title: 'Detail',
    description: 'Насыщенность мелодии.',
    options: COMPLEXITY_OPTIONS,
    details: {
      simple: 'меньше нот и проще запомнить',
      balanced: 'средняя детализация',
      twisty: 'больше движения и неожиданных поворотов'
    }
  },
  {
    title: 'Hook Strength',
    description: 'Насколько явно мелодия стремится быть цепкой.',
    options: HOOKINESS_OPTIONS,
    details: {
      safe: 'мягкая и спокойная идея',
      catchy: 'заметный, но сбалансированный хук',
      bold: 'акцентная и более запоминающаяся фраза'
    }
  }
] as const;

const manualSettings = [
  ['Key / Tonic', 'Основная нота тональности. Она сохраняется при смене Hook Intent.'],
  ['Scale Mode', `Лад мелодии: ${SCALE_OPTIONS.join(', ')}.`],
  ['Bars', 'Длина идеи от 2 до 16 тактов.'],
  ['Tempo', 'Скорость воспроизведения от 60 до 190 BPM.'],
  ['Octave', 'Основной регистр мелодии: от 2 до 6 октавы.'],
  ['Pitch Range', 'Допустимый размах мелодии от 7 до 36 полутонов.']
] as const;

const advancedSettings = [
  ['Note density', 'сколько нот появляется в доступном времени'],
  ['Rest chance', 'как часто генератор оставляет паузы'],
  ['Variation amount', 'насколько части фразы отличаются друг от друга'],
  ['Randomness', 'сколько непредсказуемости допускается при генерации']
] as const;

const chordOptionGroups = [
  {
    title: 'Pattern',
    options: CHORD_PATTERN_OPTIONS,
    details: {
      sustained: 'один длинный аккордовый импульс',
      'half-bar': 'два импульса на такт',
      'quarter-pulse': 'движение по четвертям',
      syncopated: 'более живой синкопированный рисунок'
    }
  },
  {
    title: 'Length',
    options: CHORD_LENGTH_OPTIONS,
    details: {
      long: 'длинные ноты',
      medium: 'средняя длительность',
      short: 'короткие ноты',
      staccato: 'максимально отрывистая подача'
    }
  },
  {
    title: 'Feel',
    options: CHORD_FEEL_OPTIONS,
    details: {
      straight: 'ровное исполнение',
      subtle: 'лёгкая живость',
      groovy: 'больше ритмического движения',
      loose: 'более свободное ощущение'
    }
  }
] as const;

const bassDetails = {
  'root-pulse': 'простой пульс по основным нотам аккордов',
  groove: 'более ритмичный басовый рисунок',
  sparse: 'редкий минималистичный бас'
} as const;

const availableDownloads = DOWNLOAD_OPTIONS.filter((option) => !option.disabled);
---

<BaseLayout
  title="Инструкция"
  description="Практическая инструкция по Melody Seed Generator: первый seed, настройки, слои, сохранение проекта и экспорт WAV/MIDI."
>
  <main class="page-content instructions-page">
    <header class="instr-hero">
      <h1>Инструкция</h1>
      <p class="lead">
        Создайте короткую музыкальную идею из мелодии, аккордов и баса — затем сохраните её или
        продолжите работу в другом инструменте.
      </p>
      <p>
        Melody Seed Generator — не DAW и не генератор готовых песен. Он помогает быстро найти отправную
        точку: ритм, гармонию и мелодический контур.
      </p>
    </header>

    <div class="instr-layout">
      <nav class="instr-toc" aria-label="Содержание инструкции">
        <h2 class="instr-toc__title">Содержание</h2>
        <div class="instr-toc__links">
          <a href="#quick-start" class="instr-toc__link">Первый seed</a>
          <a href="#settings" class="instr-toc__link">Настройки</a>
          <a href="#layers" class="instr-toc__link">Слои</a>
          <a href="#projects" class="instr-toc__link">Project</a>
          <a href="#export" class="instr-toc__link">Экспорт</a>
          <a href="#limits" class="instr-toc__link">Ограничения</a>
        </div>
      </nav>

      <article class="instr-main">
        <section class="instr-section" id="quick-start">
          <h2>Первый seed за минуту</h2>
          <ol class="instr-steps">
            <li>Откройте <a href="/generator">генератор</a>.</li>
            <li>Сначала выберите пять параметров в Hook Intent — они задают характер идеи.</li>
            <li>При необходимости уточните тональность, темп, длину и диапазон в Melody Settings.</li>
            <li>Нажмите Generate Seed, затем Play.</li>
            <li>Отключайте Chord Layer и Bass Layer, чтобы сравнить звучание со слоями и без них.</li>
            <li>Если результат нравится, сразу скачайте Project, WAV или MIDI.</li>
          </ol>

          <p class="instr-callout instr-callout--warning">
            Generate New Seed заменяет текущий результат. Истории версий в генераторе нет, поэтому
            сохраните удачный вариант как Project до следующей генерации.
          </p>

          <dl class="instr-term-list" aria-label="Основные термины">
            <div><dt>Seed</dt><dd>короткая музыкальная заготовка, а не готовая песня.</dd></div>
            <div><dt>Hook Intent</dt><dd>набор пресетов, определяющий характер и роль мелодии.</dd></div>
            <div><dt>Layer</dt><dd>отдельный музыкальный слой: мелодия, аккорды или бас.</dd></div>
            <div><dt>DAW</dt><dd>программа для записи и редактирования музыки.</dd></div>
          </dl>
        </section>

        <section class="instr-section" id="settings">
          <h2>Intent и ручные настройки</h2>
          <p>
            Начинайте с Hook Intent, затем переходите к ручным настройкам. Любое изменение Hook Intent
            заново применяет пресет и перезаписывает Scale Mode, Bars, Tempo, Octave, Pitch Range и все
            параметры Advanced tuning. Key / Tonic при этом сохраняется.
          </p>

          <h3 class="instr-subheading">Hook Intent</h3>
          <div class="instr-card-grid instr-card-grid--settings">
            {intentGroups.map((group) => (
              <article class="instr-card">
                <h3>{group.title}</h3>
                <p>{group.description}</p>
                <ul class="instr-option-list">
                  {group.options.map((option) => (
                    <li><strong>{option.label}</strong> — {group.details[option.value]}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>

          <h3 class="instr-subheading">Melody Settings</h3>
          <dl class="instr-setting-list">
            {manualSettings.map(([name, description]) => (
              <div><dt>{name}</dt><dd>{description}</dd></div>
            ))}
          </dl>

          <h3 class="instr-subheading">Advanced tuning</h3>
          <p>Раскройте этот блок, только если хотите точнее управлять характером генерации.</p>
          <dl class="instr-setting-list">
            {advancedSettings.map(([name, description]) => (
              <div><dt>{name}</dt><dd>{description}.</dd></div>
            ))}
          </dl>
        </section>

        <section class="instr-section" id="layers">
          <h2>Melody, Chord и Bass Layer</h2>
          <div class="instr-card-grid instr-card-grid--layers">
            <article class="instr-card instr-card--melody">
              <h3>Melody</h3>
              <p>Главная музыкальная фраза. Новая мелодия создаётся кнопкой Generate New Seed.</p>
            </article>
            <article class="instr-card instr-card--chord">
              <h3>Chord Layer</h3>
              <p>Гармоническая поддержка. Его можно отключить, настроить или регенерировать.</p>
            </article>
            <article class="instr-card instr-card--bass">
              <h3>Bass Layer</h3>
              <p>Нижний голос, построенный по текущим аккордам. Его можно отключить или регенерировать.</p>
            </article>
          </div>

          <p class="instr-callout">
            Аккорды и бас связаны: изменение Pattern, Length, Feel или регенерация Chord Layer
            автоматически перестраивает Bass Layer под новые аккорды. Выбранный режим баса сохраняется.
          </p>

          <h3 class="instr-subheading">Настройки Chord Layer</h3>
          <div class="instr-card-grid instr-card-grid--settings">
            {chordOptionGroups.map((group) => (
              <article class="instr-card">
                <h3>{group.title}</h3>
                <ul class="instr-option-list">
                  {group.options.map((option) => (
                    <li><strong>{option.label}</strong> — {group.details[option.value]}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>

          <h3 class="instr-subheading">Режим Bass Layer</h3>
          <ul class="instr-option-list instr-option-list--standalone">
            {BASS_MODE_OPTIONS.map((option) => (
              <li><strong>{option.label}</strong> — {bassDetails[option.value]}</li>
            ))}
          </ul>
        </section>

        <section class="instr-section" id="projects">
          <h2>Как сохранить и открыть Project</h2>
          <p>
            Project — файл <code>.melody-seed.json</code> с полной копией текущего состояния: мелодией,
            настройками, аккордами, басом и состоянием слоёв. Это лучший формат для продолжения работы
            именно в Melody Seed Generator.
          </p>
          <ol class="instr-steps">
            <li>В блоке Download выберите Project и нажмите кнопку скачивания.</li>
            <li>Чтобы вернуться к работе, перетащите файл в зону Open Project над настройками.</li>
            <li>Либо нажмите значок загрузки в этой зоне и выберите файл вручную.</li>
          </ol>
          <p class="instr-callout instr-callout--warning">
            Открытие Project заменяет текущий seed. Если текущая версия нужна, сначала скачайте её
            отдельным Project-файлом.
          </p>
        </section>

        <section class="instr-section" id="export">
          <h2>WAV, MIDI и дальнейшая работа</h2>
          <p>
            В WAV и MIDI попадают только активные слои. Перед скачиванием включите Melody, Chord Layer и
            Bass Layer в нужной комбинации. Project сохраняет полное состояние, включая отключённые слои.
          </p>
          <div class="instr-card-grid instr-card-grid--downloads">
            {availableDownloads.map((option) => (
              <article class:list={['instr-card', { 'instr-card--highlight': option.value === 'project' }]}>
                <h3>{option.label}</h3>
                {option.value === 'wav' && (
                  <p>Готовое аудио для прослушивания, отправки или использования как звуковой референс.</p>
                )}
                {option.value === 'midi' && (
                  <p>Редактируемые ноты для DAW: можно менять инструменты, партии и аранжировку.</p>
                )}
                {option.value === 'project' && (
                  <p>Полное состояние генератора для сохранения версии и продолжения работы позже.</p>
                )}
              </article>
            ))}
          </div>
          <p>
            Для Suno, Udio и других AI-сервисов WAV можно использовать как музыкальное направление, а
            текстом описать жанр, атмосферу, вокал и желаемое звучание. Возможности загрузки аудио и
            правила сервисов меняются — проверяйте их актуальный интерфейс перед работой.
          </p>
          <p class="instr-callout">
            Внешний сервис может переосмыслить исходную идею и не обязан точно повторять мелодию,
            аккорды или бас. MP3 сейчас отображается в списке форматов, но недоступен для скачивания.
          </p>
        </section>

        <section class="instr-section" id="limits">
          <h2>Что инструмент делает — и чего не делает</h2>
          <ul class="instr-fact-list">
            <li>Создаёт короткую процедурную идею без сэмплов и аудиопетель.</li>
            <li>Не редактирует отдельные ноты внутри piano roll.</li>
            <li>Не хранит историю вариантов в браузере — важные версии нужно скачивать.</li>
            <li>Не заменяет DAW и не создаёт законченную аранжировку.</li>
            <li>Не гарантирует уникальность, коммерческий успех или точное повторение во внешнем сервисе.</li>
          </ul>
          <p>
            Практичная цель генератора — быстрее начать трек и получить материал, который можно развить
            дальше.
          </p>
        </section>

        <section class="instr-section instr-cta" id="start">
          <h2>Создать первый seed</h2>
          <p>Выберите Hook Intent, уточните настройки и сохраните удачный вариант до новой генерации.</p>
          <a href="/generator" class="button-link primary">Открыть генератор</a>
        </section>
      </article>
    </div>
  </main>
</BaseLayout>
