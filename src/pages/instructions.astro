---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  COMPLEXITY_OPTIONS,
  DRAMA_OPTIONS,
  GENRE_OPTIONS,
  HOOKINESS_OPTIONS,
  ROLE_OPTIONS
} from '../lib/melody/intent';
import { SCALE_OPTIONS } from '../lib/music/scales';
import {
  BASS_MODE_OPTIONS,
  CHORD_FEEL_OPTIONS,
  CHORD_LENGTH_OPTIONS,
  CHORD_PATTERN_OPTIONS,
  DOWNLOAD_OPTIONS
} from '../lib/ui/controlOptions';

const intentGroups = [
  {
    title: 'Melodic Language',
    description: 'Общий музыкальный характер.',
    options: GENRE_OPTIONS,
    details: {
      'pop-hook': 'понятные диатонические ходы для поп-идей',
      'dark-trap': 'тёмное минорное настроение',
      'edm-lead': 'яркая и энергичная электронная подача',
      'afro-house': 'модальное и ритмичное движение',
      cinematic: 'атмосферный кинематографичный минор',
      hyperpop: 'резкий, яркий и современный характер'
    }
  },
  {
    title: 'Song Part',
    description: 'Роль идеи в будущем треке.',
    options: ROLE_OPTIONS,
    details: {
      'chorus-hook': 'цепкая фраза для припева или главного хука',
      'verse-motif': 'более спокойный мотив для куплета',
      'drop-lead': 'энергичная и повторяемая идея для дропа',
      'pre-chorus-lift': 'переходная фраза с движением к припеву'
    }
  },
  {
    title: 'Phrase Shape',
    description: 'Драматургия музыкальной фразы.',
    options: DRAMA_OPTIONS,
    details: {
      'question-answer': 'две части ощущаются как вопрос и ответ',
      'build-release': 'нарастание заканчивается разрешением',
      'call-response': 'музыкальный призыв получает отклик',
      'loopable-hook': 'фраза рассчитана на повтор по кругу'
    }
  },
  {
    title: 'Detail',
    description: 'Насыщенность мелодии.',
    options: COMPLEXITY_OPTIONS,
    details: {
      simple: 'меньше нот и проще запомнить',
      balanced: 'средняя детализация',
      twisty: 'больше движения и неожиданных поворотов'
    }
  },
  {
    title: 'Hook Strength',
    description: 'Насколько явно мелодия стремится быть цепкой.',
    options: HOOKINESS_OPTIONS,
    details: {
      safe: 'мягкая и спокойная идея',
      catchy: 'заметный, но сбалансированный хук',
      bold: 'акцентная и более запоминающаяся фраза'
    }
  }
] as const;

const manualSettings = [
  ['Key / Tonic', 'Основная нота тональности. Она сохраняется при смене Hook Intent.'],
  ['Scale Mode', `Лад мелодии: ${SCALE_OPTIONS.join(', ')}.`],
  ['Bars', 'Длина идеи от 2 до 16 тактов.'],
  ['Tempo', 'Скорость воспроизведения от 60 до 190 BPM.'],
  ['Octave', 'Основной регистр мелодии: от 2 до 6 октавы.'],
  ['Pitch Range', 'Допустимый размах мелодии от 7 до 36 полутонов.']
] as const;

const advancedSettings = [
  ['Note density', 'сколько нот появляется в доступном времени'],
  ['Rest chance', 'как часто генератор оставляет паузы'],
  ['Variation amount', 'насколько части фразы отличаются друг от друга'],
  ['Randomness', 'сколько непредсказуемости допускается при генерации']
] as const;

const chordOptionGroups = [
  {
    title: 'Pattern',
    options: CHORD_PATTERN_OPTIONS,
    details: {
      sustained: 'один длинный аккордовый импульс',
      'half-bar': 'два импульса на такт',
      'quarter-pulse': 'движение по четвертям',
      syncopated: 'более живой синкопированный рисунок'
    }
  },
  {
    title: 'Length',
    options: CHORD_LENGTH_OPTIONS,
    details: {
      long: 'длинные ноты',
      medium: 'средняя длительность',
      short: 'короткие ноты',
      staccato: 'максимально отрывистая подача'
    }
  },
  {
    title: 'Feel',
    options: CHORD_FEEL_OPTIONS,
    details: {
      straight: 'ровное исполнение',
      subtle: 'лёгкая живость',
      groovy: 'больше ритмического движения',
      loose: 'более свободное ощущение'
    }
  }
] as const;

const bassDetails = {
  'root-pulse': 'простой пульс по основным нотам аккордов',
  groove: 'более ритмичный басовый рисунок',
  sparse: 'редкий минималистичный бас'
} as const;

const availableDownloads = DOWNLOAD_OPTIONS.filter((option) => !option.disabled);
---

<BaseLayout
  title="Инструкция"
  description="Практическая инструкция по Melody Seed Generator: первый seed, настройки, слои, сохранение проекта и экспорт WAV/MIDI."
>
  <main class="page-content instructions-page" id="main-content">
    <header class="instr-cover panel" id="top">
      <div class="instr-cover__copy">
        <p class="eyebrow instr-cover__eyebrow"><span aria-hidden="true"></span> Инструкция</p>
        <h1>Как работать с Melody Seed Generator</h1>
        <p>
          От первого seed до файла, который можно продолжить в DAW или использовать как музыкальный
          референс.
        </p>
        <a href="/generator" class="instr-primary-link">Открыть генератор <span aria-hidden="true">↗</span></a>
      </div>
      <div class="instr-cover__visual" aria-hidden="true">
        <span>SEED FLOW</span>
        <div class="instr-cover__lane instr-cover__lane--melody"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="instr-cover__lane instr-cover__lane--chord"><i></i><i></i><i></i></div>
        <div class="instr-cover__lane instr-cover__lane--bass"><i></i><i></i><i></i><i></i></div>
      </div>
    </header>

    <article class="instr-article">
      <p class="instr-lead">
        Генератор создаёт короткую музыкальную заготовку с мелодией, аккордами и басом. В этой
        инструкции собраны основные приёмы работы с ним. Вы узнаете, в каком порядке менять настройки,
        как не потерять удачный вариант и в каком формате сохранить результат.
      </p>

      <nav class="instr-contents" aria-label="Содержание инструкции">
        <p>Навигация</p>
        <ol>
          <li><a href="#quick-start">Первый seed за 1 минуту</a></li>
          <li><a href="#settings">Как выбирать настройки</a></li>
          <li><a href="#layers">Как работать со слоями</a></li>
          <li><a href="#projects">Как сохранить результат</a></li>
          <li><a href="#export">Что скачать</a></li>
        </ol>
      </nav>

      <section class="instr-chapter" id="quick-start">
        <h2>Первый seed за 1 минуту</h2>
        <p>
          Не пытайтесь сразу разобраться во всех параметрах. Для начала достаточно пройти 4 шага.
        </p>

        <ol class="instr-reading-steps">
          <li>
            <span>1</span>
            <div>
              <h3>Задайте характер</h3>
              <p>Выберите 5 параметров в Hook Intent. Они соберут рабочий пресет автоматически.</p>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <h3>Создайте идею</h3>
              <p>Нажмите Generate Seed, затем Play и послушайте результат целиком.</p>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <h3>Сравните слои</h3>
              <p>Отключайте Chord Layer и Bass Layer, чтобы понять, что даёт каждый слой.</p>
            </div>
          </li>
          <li>
            <span>4</span>
            <div>
              <h3>Сохраните удачный вариант</h3>
              <p>Скачайте Project до следующей генерации, а WAV или MIDI — для дальнейшей работы.</p>
            </div>
          </li>
        </ol>

        <aside class="instr-note instr-note--warm">
          <strong>Generate New Seed заменяет текущий результат</strong>
          <p>Истории версий в генераторе нет, поэтому хороший вариант лучше сохранить сразу.</p>
        </aside>
      </section>

      <section class="instr-chapter" id="settings">
        <h2>Сначала соберите основу, затем настройте детали</h2>
        <p>
          Работу над seed лучше начинать с Hook Intent. Он определяет музыкальный язык, роль фразы, её
          форму, детализацию и силу хука. Затем можно вручную изменить тональность, темп, длину и диапазон.
        </p>
        <p>
          Сначала выберите Hook Intent и только потом переходите к ручным настройкам. Если изменить
          Hook Intent позже, пресет заново выставит Scale Mode, Bars, Tempo, Octave, Pitch Range
          и параметры Advanced tuning. Настройка Key / Tonic при этом сохранится.
        </p>

        <aside class="instr-pullquote">
          Сначала настройте Hook Intent, затем перейдите к Melody Settings. Используйте Advanced tuning,
          когда уже понятно, что именно нужно изменить.
        </aside>

        <div class="instr-reference">
          <h3>Справочник по настройкам</h3>

          <details class="instr-text-disclosure">
            <summary>Hook Intent <span>5 параметров характера</span></summary>
            <div class="instr-text-disclosure__body">
              {intentGroups.map((group) => (
                <section>
                  <h4>{group.title}</h4>
                  <p>{group.description}</p>
                  <dl>
                    {group.options.map((option) => (
                      <div><dt>{option.label}</dt><dd>{group.details[option.value]}</dd></div>
                    ))}
                  </dl>
                </section>
              ))}
            </div>
          </details>

          <details class="instr-text-disclosure">
            <summary>Melody Settings <span>тональность, темп и диапазон</span></summary>
            <dl class="instr-text-disclosure__body instr-definition-list">
              {manualSettings.map(([name, description]) => (
                <div><dt>{name}</dt><dd>{description}</dd></div>
              ))}
            </dl>
          </details>

          <details class="instr-text-disclosure">
            <summary>Advanced tuning <span>плотность и вариативность</span></summary>
            <dl class="instr-text-disclosure__body instr-definition-list">
              {advancedSettings.map(([name, description]) => (
                <div><dt>{name}</dt><dd>{description}.</dd></div>
              ))}
            </dl>
          </details>
        </div>
      </section>

      <section class="instr-chapter instr-chapter--wide" id="layers">
        <div class="instr-reading-column">
          <h2>Мелодия, аккорды и бас работают вместе</h2>
          <p>
          После генерации появляются 3 слоя. Их можно слушать вместе или отключать по одному. Так проще
          понять основу идеи и решить, что оставить.
        </p>
        </div>

        <div class="instr-layer-story" aria-label="Описание музыкальных слоёв">
          <article class="instr-layer-story__item instr-layer-story__item--melody">
            <span>M</span>
            <div><h3>Melody</h3><p>Главная фраза. Меняется при генерации нового seed.</p></div>
          </article>
          <article class="instr-layer-story__item instr-layer-story__item--chord">
            <span>C</span>
            <div><h3>Chord Layer</h3><p>Гармония. Её можно отключить, настроить или регенерировать.</p></div>
          </article>
          <article class="instr-layer-story__item instr-layer-story__item--bass">
            <span>B</span>
            <div><h3>Bass Layer</h3><p>Нижний голос, который строится по текущим аккордам.</p></div>
          </article>
        </div>

        <div class="instr-reading-column">
          <aside class="instr-note instr-note--mint">
            <strong>Аккорды и бас связаны</strong>
            <p>Изменение или регенерация Chord Layer перестраивает бас под новые аккорды, сохраняя выбранный Bass Mode.</p>
          </aside>

          <details class="instr-text-disclosure instr-text-disclosure--spaced">
            <summary>Режимы Chord и Bass Layer <span>Pattern, Length, Feel и Bass Mode</span></summary>
            <div class="instr-text-disclosure__body">
              {chordOptionGroups.map((group) => (
                <section>
                  <h4>{group.title}</h4>
                  <dl>
                    {group.options.map((option) => (
                      <div><dt>{option.label}</dt><dd>{group.details[option.value]}</dd></div>
                    ))}
                  </dl>
                </section>
              ))}
              <section>
                <h4>Bass Mode</h4>
                <dl>
                  {BASS_MODE_OPTIONS.map((option) => (
                    <div><dt>{option.label}</dt><dd>{bassDetails[option.value]}</dd></div>
                  ))}
                </dl>
              </section>
            </div>
          </details>
        </div>
      </section>

      <section class="instr-chapter" id="projects">
        <h2>Project — точка возврата к работе</h2>
        <p>
          Файл <code>.melody-seed.json</code> хранит полное состояние генератора: мелодию, настройки,
          аккорды, бас и включённые слои. WAV и MIDI нужны для работы вне генератора, а Project — чтобы
          вернуться к тому же варианту позже.
        </p>

        <ol class="instr-project-steps">
          <li><strong>Чтобы сохранить</strong><span>выберите Project в блоке Download и нажмите кнопку скачивания</span></li>
          <li><strong>Чтобы открыть</strong><span>перетащите файл в Open Project или нажмите значок загрузки</span></li>
        </ol>

        <p class="instr-caption">Открытие Project также заменяет текущий seed.</p>
      </section>

      <section class="instr-chapter instr-chapter--wide" id="export">
        <div class="instr-reading-column">
          <h2>Выберите формат под следующую задачу</h2>
          <p>
            Перед экспортом включите нужную комбинацию слоёв. В WAV и MIDI попадут только активные
            Melody, Chord Layer и Bass Layer.
          </p>
        </div>

        <div class="instr-format-row">
          {availableDownloads.map((option) => (
            <article class:list={['instr-format-card', `instr-format-card--${option.value}`]}>
              <span>{option.value === 'project' || option.value === 'provenance' ? 'JSON' : option.label}</span>
              <h3>{option.label}</h3>
              {option.value === 'wav' && <p>Готовое аудио для прослушивания или использования как референса.</p>}
              {option.value === 'midi' && <p>Редактируемые ноты для работы с инструментами и аранжировкой в DAW.</p>}
              {option.value === 'project' && <p>Полное состояние для продолжения работы в генераторе.</p>}
              {option.value === 'provenance' && <p>Технический паспорт seed: настройки, слои, хэш и ограничения проверки сходства.</p>}
            </article>
          ))}
        </div>

        <div class="instr-reading-column">
          <p class="instr-caption">MP3 пока недоступен. Project сохраняет и отключённые слои, а Provenance — техническое происхождение seed.</p>
          <p>
            WAV можно передать Suno, Udio или другому AI-сервису как музыкальное направление. Внешний
            сервис может переосмыслить исходную идею и не обязан точно повторять мелодию, аккорды или бас.
          </p>
        </div>
      </section>

      <section class="instr-chapter instr-limits" id="limits">
        <p class="instr-limits__eyebrow">Коротко о главном</p>
        <h2>Что важно помнить</h2>
        <ul class="instr-clean-list">
          <li>
            <span class="instr-clean-list__index" aria-hidden="true">01</span>
            <div><strong>Это не готовая песня</strong><p>Генератор создаёт короткую отправную точку.</p></div>
          </li>
          <li>
            <span class="instr-clean-list__index" aria-hidden="true">02</span>
            <div><strong>Это не редактор нот</strong><p>Менять отдельные ноты в piano roll нельзя.</p></div>
          </li>
          <li>
            <span class="instr-clean-list__index" aria-hidden="true">03</span>
            <div><strong>Это не история версий</strong><p>Важные варианты нужно скачивать самостоятельно.</p></div>
          </li>
          <li>
            <span class="instr-clean-list__index" aria-hidden="true">04</span>
            <div><strong>Это не замена DAW</strong><p>Полноценную аранжировку удобнее продолжить в другом инструменте.</p></div>
          </li>
        </ul>
      </section>

      <footer class="instr-ending">
        <p>Готовы попробовать?</p>
        <h2>Создайте seed и сохраните первый удачный вариант</h2>
        <div>
          <a href="/generator" class="instr-primary-link">Открыть генератор <span aria-hidden="true">↗</span></a>
          <a href="#top" class="instr-back-link">Вернуться к началу ↑</a>
        </div>
      </footer>
    </article>
  </main>
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
