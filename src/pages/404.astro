---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Страница не найдена"
  description="Запрошенная страница не найдена. Вернитесь в Melody Seed Generator или откройте инструкцию."
  robots="noindex,follow"
>
  <main class="page-content not-found-page" id="main-content">
    <section class="panel not-found-card">
      <p class="eyebrow">Ошибка 404</p>
      <h1>Такой страницы нет</h1>
      <p>Возможно, ссылка устарела или в адресе есть опечатка.</p>
      <div>
        <a class="not-found-primary" href="/generator">Открыть генератор</a>
        <a href="/instructions">Перейти к инструкции</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found-page {
    display: grid;
    min-height: calc(100vh - 82px);
    place-items: center;
  }

  .not-found-card {
    width: min(100%, 42rem);
    padding: clamp(1.5rem, 5vw, 3rem);
    text-align: center;
  }

  .not-found-card h1 {
    margin: 0.6rem 0 0;
    font-size: clamp(2.4rem, 8vw, 4.8rem);
    line-height: 1;
  }

  .not-found-card > p:not(.eyebrow) {
    color: rgba(238, 242, 247, 0.72);
    line-height: 1.6;
  }

  .not-found-card div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .not-found-card a {
    border: 1px solid rgba(217, 226, 239, 0.18);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    color: #fff;
    text-decoration: none;
  }

  .not-found-card .not-found-primary {
    border-color: rgba(255, 153, 108, 0.42);
    background: linear-gradient(135deg, #ff8a55, #ef542f);
    color: #1b0b06;
    font-weight: 700;
  }
</style>
