---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../development-page.css';

const supportUrl = 'https://pay.cloudtips.ru/p/9fb52846';

const roadmap = [
  {
    value: 'melody-development',
    marker: 'Практическая польза',
    title: 'Развитие мелодической идеи',
    text: 'Продолжение, вариация, кульминация и завершение исходного seed. Отдельные связанные идеи для куплета, припева, бриджа и хука.',
    accent: 'warm'
  },
  {
    value: 'indian-ragas',
    marker: 'Уникальное направление',
    title: 'Генератор индийских раг',
    text: 'Мелодия по правилам выбранной раги: допустимые ноты, характерные движения и опорные ступени — вместе с описанием для SUNO.',
    accent: 'mint'
  },
  {
    value: 'seed-to-suno',
    marker: 'Быстрее до результата',
    title: 'Seed → SUNO',
    text: 'Короткое музыкальное описание на основе seed: лад, темп, диапазон, характер движения и драматургия — готовые ориентиры для генерации трека.',
    accent: 'neutral'
  }
];
---

<BaseLayout
  title="Развитие проекта"
  description="Поддержка и открытый план развития Melody Seed Generator — инструмента для создания мелодических идей и генерации треков в SUNO."
>
  <main class="development-page" id="main-content">
    <section class="development-hero">
      <div class="development-hero__copy">
        <p class="development-eyebrow"><span aria-hidden="true"></span> Открытая разработка</p>
        <h1>Помогите проекту расти</h1>
        <p class="development-hero__lead">
          Melody Seed Generator помогает быстро получить управляемую музыкальную идею и перейти
          к генерации трека в SUNO. Поддержка пользователей позволит проверить, нужен ли проект
          дальше, и выбрать действительно полезные функции.
        </p>
        <div class="development-actions">
          <a class="development-button" href={supportUrl} target="_blank" rel="noopener noreferrer">
            Поддержать проект <span aria-hidden="true">↗</span>
          </a>
          <a class="development-text-link" href="#roadmap">Посмотреть направления</a>
        </div>
      </div>
      <div class="development-hero__portrait">
        <img
          src="/images/development-portrait.jpg"
          srcset="/images/development-portrait-600.jpg 600w, /images/development-portrait-960.jpg 960w, /images/development-portrait.jpg 1200w"
          sizes="(max-width: 720px) calc(100vw - 24px), 42vw"
          alt="Михаил, автор Melody Seed Generator"
          width="1200"
          height="1200"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </section>

    <section class="development-principle" aria-labelledby="principle-title">
      <p>Принцип продукта</p>
      <div>
        <h2 id="principle-title">Мы не строим ещё одну DAW</h2>
        <p>
          Новая функция появляется только тогда, когда помогает придумать мелодию, даёт больше
          контроля над её характером или сокращает путь от идеи до трека в SUNO. Сведение,
          мастеринг и многодорожечный монтаж остаются за границами проекта.
        </p>
      </div>
    </section>

    <section id="support" class="development-support" aria-labelledby="support-title">
      <div class="development-support__copy">
        <p class="development-section-label">Поддержать разработку</p>
        <h2 id="support-title">Сбор на следующий этап проекта</h2>
        <p>
          Текущая версия генератора остаётся доступной. Сбор поможет выделить время и ресурсы
          на следующий рабочий прототип, проверить его вместе с пользователями и довести до
          понятного инструмента для SUNO.
        </p>

        <div class="development-spend-list" aria-label="На что пойдёт поддержка">
          <div><span>01</span><p>Исследование и проектирование новых мелодических режимов</p></div>
          <div><span>02</span><p>Разработка, тестирование и адаптация под разные экраны</p></div>
          <div><span>03</span><p>Проверка музыкальных правил и консультации специалистов</p></div>
          <div><span>04</span><p>Хостинг, домен и техническое сопровождение проекта</p></div>
        </div>

        <p class="development-support__note">
          Это добровольная поддержка развития проекта. Она не покупает доступ и не открывает
          платных функций.
        </p>
        <a class="development-button" href={supportUrl} target="_blank" rel="noopener noreferrer">
          Перейти к сбору <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="development-payment">
        <div class="development-payment__heading">
          <div>
            <p>CloudTips</p>
            <h3>Поддержка проекта</h3>
          </div>
          <span>Оплата на стороне сервиса</span>
        </div>

        <div class="development-payment__visual">
          <img
            src="/images/cloudtips-background.png"
            alt=""
            width="480"
            height="220"
            loading="lazy"
            decoding="async"
          />
          <div class="development-payment__goal">
            <span>Цель сбора</span>
            <strong>75 000 ₽</strong>
          </div>
        </div>

        <div class="development-payment__body">
          <p>
            Актуальный прогресс и форма поддержки откроются на защищённой странице CloudTips.
          </p>
          <a href={supportUrl} target="_blank" rel="noopener noreferrer">
            Открыть сбор в CloudTips <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section id="roadmap" class="development-roadmap" aria-labelledby="roadmap-title">
      <div class="development-section-heading">
        <p class="development-section-label">Что делать дальше</p>
        <div>
          <h2 id="roadmap-title">Три направления развития</h2>
          <p>
            Это не обещанный список релизов. Сначала важно понять, какая задача приносит
            пользователям больше пользы при работе с SUNO.
          </p>
        </div>
      </div>

      <form
        class="development-vote"
        name="roadmap-vote"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="roadmap-vote" />
        <p class="development-vote__trap" hidden>
          <label>Не заполняйте это поле: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <fieldset>
          <legend>Выберите самое полезное направление</legend>
          <div class="development-roadmap__grid">
            {roadmap.map((item, index) => (
              <label class={`development-roadmap-card development-roadmap-card--${item.accent}`}>
                <input type="radio" name="feature" value={item.value} required />
                <span class="development-roadmap-card__content">
                  <span class="development-roadmap-card__meta">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <span>{item.marker}</span>
                  </span>
                  <strong>{item.title}</strong>
                  <span class="development-roadmap-card__text">{item.text}</span>
                  <span class="development-roadmap-card__choice" aria-hidden="true">
                    <span></span> Выбрать
                  </span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="development-vote__footer">
          <p>Один ответ с устройства. Пожертвование для голосования не требуется.</p>
          <button class="development-button" type="submit">Проголосовать</button>
        </div>
        <p class="development-vote__status" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="development-feedback" aria-labelledby="feedback-title">
      <div>
        <p class="development-section-label">Влиять можно без доната</p>
        <h2 id="feedback-title">Расскажите, чего не хватает для работы с SUNO</h2>
      </div>
      <div>
        <p>
          Полезнее всего конкретный сценарий: что вы пытаетесь создать, где теряете контроль
          над мелодией и какой результат хотели бы получить быстрее.
        </p>
        <a href="https://vk.ru/mr_madhu" target="_blank" rel="noopener noreferrer">
          Написать в группу mr_Madhu <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const voteForm = document.querySelector<HTMLFormElement>('.development-vote');
  const voteStatus = voteForm?.querySelector<HTMLElement>('.development-vote__status');
  const voteButton = voteForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const storageKey = 'melody-seed-roadmap-vote';

  function showCompletedVote(value: string) {
    if (!voteForm || !voteStatus || !voteButton) return;

    const selected = voteForm.querySelector<HTMLInputElement>(`input[name="feature"][value="${value}"]`);
    if (selected) selected.checked = true;

    voteForm.querySelectorAll<HTMLInputElement>('input[name="feature"]').forEach((input) => {
      input.disabled = true;
    });
    voteButton.hidden = true;
    voteStatus.textContent = 'Спасибо! Ваш голос учтён.';
    voteStatus.dataset.state = 'success';
  }

  try {
    const savedVote = window.localStorage.getItem(storageKey);
    if (savedVote) showCompletedVote(savedVote);
  } catch {
    // Голосование продолжит работать, даже если хранилище браузера недоступно.
  }

  voteForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!voteStatus || !voteButton) return;

    const formData = new FormData(voteForm);
    const selectedVote = formData.get('feature');
    if (typeof selectedVote !== 'string') return;

    voteButton.disabled = true;
    voteButton.textContent = 'Отправляем…';
    voteStatus.textContent = '';
    delete voteStatus.dataset.state;

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData as unknown as Record<string, string>).toString()
      });

      if (!response.ok) throw new Error(`Form submission failed: ${response.status}`);

      try {
        window.localStorage.setItem(storageKey, selectedVote);
      } catch {
        // Успешная отправка важнее локальной отметки о голосовании.
      }
      showCompletedVote(selectedVote);
    } catch {
      voteButton.disabled = false;
      voteButton.textContent = 'Проголосовать';
      voteStatus.textContent = 'Не удалось отправить голос. Проверьте соединение и попробуйте ещё раз.';
      voteStatus.dataset.state = 'error';
    }
  });
</script>
